  "narrative": {
    "northStar": "The Working Sketchbook",
    "overview": "The site is a designer's notebook that happens to be a website. Pages are sheets of cream paper separated by thin tan rules; type is dark ink; the only colour is a single coral and a lime highlighter used the way a pen would be. Roy himself appears as a hand-drawn character and the supporting drawings are ink and pencil hatching on paper, so the interface and the artwork share one material.\n\nIt is warm and plain-spoken for non-technical owners of small businesses. Nothing is clever for its own sake: pill buttons, soft cards, mono labels and generous whitespace carry the page, and the drawings do the personality.",
    "keyCharacteristics": [
      "Cream and tan paper bands, alternating down the page.",
      "One coral accent and one lime highlighter, both rare.",
      "Space Grotesk for voice, IBM Plex Mono for labels, Caveat for the occasional handwritten note.",
      "Hand-drawn character and spot illustrations, never stock imagery or 3D.",
      "Soft, tinted shadows only where something is lifted off the paper."
    ],
    "rules": [
      {
        "name": "The One Pen Rule",
        "body": "Coral is the only accent colour and appears on a small share of any screen: a button, a mark, a label. If two coral things compete, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Paper Skin Rule",
        "body": "The illustrated character wears no colour and his skin is the page colour. Colour on a drawing belongs to props and callouts only.",
        "section": "colors"
      },
      {
        "name": "The Annotation Rule",
        "body": "Mono is for labels and navigation only, never for paragraphs.",
        "section": "typography"
      },
      {
        "name": "The Lift Only When Lifted Rule",
        "body": "A shadow means the thing sits above the paper. Flat content gets a rule, not a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** alternate Sketchbook Cream and Tan Page bands, with a 1px Tan Rule between them.",
      "**Do** keep ink text on coral; Coral Print is for coral text on paper.",
      "**Do** use a drawn illustration from the existing set before reaching for anything else.",
      "**Do** keep every button a pill and every card at 20px.",
      "**Do** respect reduced motion; motion is short, ease-out and always optional."
    ],
    "donts": [
      "**Don't** put colour on the character, tint his skin, or draw him without the master sheet.",
      "**Don't** use gradients, glass, hard offset shadows or neon glows.",
      "**Don't** use stock photography, 3D renders or emoji as decoration.",
      "**Don't** put long paragraphs in mono, or use Caveat for anything but short notes.",
      "**Don't** add a second accent colour."
    ]
  }
