# Sanity (see .env.local for real values — not committed)
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_PROJECT_ID=
SANITY_API_READ_TOKEN=

# Contact form email delivery (src/app/api/contact/route.ts)
# Without these, the form will show a clear "not configured" error rather
# than silently failing or pretending to succeed.
#
# 1. Create a Resend account: https://resend.com
# 2. Verify a sending domain you own (e.g. roysheppard.digital) — Resend will
#    give you DNS records (SPF/DKIM) to add. "From" addresses must be on a
#    verified domain; you can't send from an arbitrary gmail.com address.
# 3. Create an API key in the Resend dashboard and set it below.
RESEND_API_KEY=
# The verified "from" address, e.g. "Roy Sheppard <contact@roysheppard.digital>"
CONTACT_FROM_EMAIL=
# Optional — defaults to the footer/CTA email in src/content/site.ts if unset
CONTACT_TO_EMAIL=
